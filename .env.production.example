# Segurança de auditoria
AUDIT_FAIL_CLOSED=true

# URLs de auditoria (ajuste conforme ambiente)
AUDIT_BASE_URL=http://audit-service:3005
AUDIT_SERVICE_URL=http://audit-service:3005

# Backup PostgreSQL
POSTGRES_CONTAINER_NAME=lframework-postgres
POSTGRES_BACKUP_DIR=/var/backups/complice/postgres
POSTGRES_BACKUP_RETENTION_DAYS=30
POSTGRES_USER=lframework

# Alertas (destino real em produção)
ALERT_WEBHOOK_URL=https://alerts.example.com/complice
