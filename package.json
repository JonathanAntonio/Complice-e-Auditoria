{
  "name": "ca",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Exemplo DDD + Microserviços + Hexagonal (TypeScript, PostgreSQL, Redis, RabbitMQ)",
  "scripts": {
    "build": "pnpm -r run build",
    "lint": "eslint .",
    "check:barrels": "node scripts/check-application-barrels.mjs",
    "test": "pnpm -r run test",
    "test:e2e": "playwright test",
    "dev:frontend": "pnpm --filter frontend run dev",
    "dev:bff": "pnpm --filter bff-service run dev",
    "dev:identity": "pnpm --filter identity-service run dev",
    "dev:compliance": "pnpm --filter compliance-service run dev",
    "dev:integration": "pnpm --filter integration-service run dev",
    "dev:audit": "pnpm --filter audit-service run dev",
    "dev:risk": "pnpm --filter risk-analysis-service run dev",
    "dev:reporting": "pnpm --filter reporting-service run dev",
    "dev:notification": "pnpm --filter notification-service run dev",
    "dev:api-docs": "pnpm --filter api-docs run dev",
    "dev:prepare": "pnpm --filter @lframework/shared run build && pnpm --filter identity-service run prisma:generate",
    "dev": "pnpm run dev:prepare && pnpm -r --parallel --stream --filter identity-service --filter compliance-service --filter integration-service --filter audit-service --filter risk-analysis-service --filter reporting-service --filter notification-service --filter api-docs --filter bff-service --filter frontend run dev",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "load-test": "tsx scripts/load-test.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "overrides": {
      "ioredis": "5.4.1"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.53.1",
    "bcrypt": "^6.0.0",
    "eslint": "^10.0.3",
    "glob": "^13.0.6",
    "tsx": "^4.21.0",
    "typescript-eslint": "^8.56.1"
  }
}
