# PostgreSQL (Docker Compose + connection strings for services)
POSTGRES_USER=lframework
POSTGRES_PASSWORD=lframework
POSTGRES_DB=lframework
POSTGRES_PORT=5432

# Connection strings (use in services; separate DBs per service)
DATABASE_URL=postgresql://lframework:lframework@localhost:5432/lframework
IDENTITY_DATABASE_URL=postgresql://lframework:lframework@localhost:5432/lframework_identity
COMPLIANCE_DATABASE_URL=postgresql://lframework:lframework@localhost:5432/lframework
INTEGRATION_DATABASE_URL=postgresql://lframework:lframework@localhost:5432/lframework_integration
AUDIT_DATABASE_URL=postgresql://lframework:lframework@localhost:5432/lframework_audit

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# RabbitMQ (Docker Compose)
RABBITMQ_USER=lframework
RABBITMQ_PASSWORD=lframework
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://lframework:lframework@localhost:5672

# Portas dos serviços
IDENTITY_SERVICE_PORT=4001
COMPLIANCE_SERVICE_PORT=4002
INTEGRATION_SERVICE_PORT=4003
AUDIT_SERVICE_PORT=4005
RISK_SERVICE_PORT=4006
REPORTING_SERVICE_PORT=4007
NOTIFICATION_SERVICE_PORT=4008
API_DOCS_PORT=4010

# Nginx no Docker: porta no host (container escuta 80). Sem Docker use 80 no host.
GATEWAY_PORT=8080

# Frontend (entrada pública única)
FRONTEND_PORT=5173
FRONTEND_BFF_URL=http://localhost:4000

# BFF (Backend For Frontend)
BFF_PORT=4000
BFF_GATEWAY_URL=http://localhost:8080
BFF_IAM_AUTH_BASE_PATH=/identity/api/v1/auth
BFF_COMPLIANCE_BASE_PATH=/compliance/api/v1
BFF_AUDIT_BASE_PATH=/audit/api/v1
BFF_RISK_BASE_PATH=/risk/api/v1
BFF_REPORTING_BASE_PATH=/reporting/api/v1
BFF_NOTIFICATION_BASE_PATH=/notification/api/v1
BFF_INTEGRATION_BASE_PATH=/integration/api/v1
BFF_INTEGRATION_API_KEY=changeme
BFF_PUBLIC_BASE_URL=https://rage-awhile-snowcap.ngrok-free.dev
BFF_SESSION_COOKIE_NAME=complice_session
BFF_SESSION_MAX_AGE_SECONDS=604800

# Identity: auth
JWT_SECRET=change-me-in-production-use-a-long-random-secret
JWT_EXPIRES_IN_SECONDS=604800
OUTBOX_RELAY_INTERVAL_MS=2000
RETENTION_SWEEP_INTERVAL_MS=3600000
INACTIVE_USER_ANONYMIZATION_AFTER_DAYS=730
INACTIVE_USER_ANONYMIZATION_BATCH_SIZE=100
COMPLIANCE_RETENTION_SWEEP_INTERVAL_MS=3600000
COMPLIANCE_RETENTION_MIN_DAYS=1825
COMPLIANCE_RETENTION_BATCH_SIZE=200
COMPLIANCE_RETENTION_SCOPE_STATUSES=resolvida,dispensada
AUDIT_RETENTION_SWEEP_INTERVAL_MS=3600000
AUDIT_RETENTION_MIN_DAYS=1825
AUDIT_RETENTION_BATCH_SIZE=1000
AUDIT_RETENTION_SCOPE_SOURCE_SERVICES=
# URL pública do identity via gateway (use domínio/ngrok em dev externo).
BASE_URL=https://rage-awhile-snowcap.ngrok-free.dev/identity
CORS_ORIGIN=

# OAuth (opcional; deixe em branco para desativar)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Integration service
INTEGRATION_API_KEY=change-me-with-at-least-16-chars
INTEGRATION_BASE_URL=http://localhost:3003
AUDIT_BASE_URL=http://localhost:3005
RISK_BASE_URL=http://localhost:3006
REPORTING_BASE_URL=http://localhost:3007
NOTIFICATION_BASE_URL=http://localhost:3008

# Ngrok (opcional, para webhooks/demo)
NGROK_AUTHTOKEN=
