generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("COMPLIANCE_DATABASE_URL")
}

enum ViolationStatus {
  aberta
  em_analise
  resolvida
  dispensada
}

model ItemModel {
  id          String   @id @default(uuid())
  name        String
  priceAmount Int      @map("price_amount")
  priceCurrency String @map("price_currency") @default("BRL")
  status      ViolationStatus @default(aberta)
  resolvedAt  DateTime? @map("resolved_at")
  dismissedAt DateTime? @map("dismissed_at")
  dismissalJustification String? @map("dismissal_justification")
  dismissalApprovedBy String? @map("dismissal_approved_by")
  retentionUntil DateTime? @map("retention_until")
  createdAt   DateTime @map("created_at")

  @@index([status])
  @@index([retentionUntil])
  @@map("items")
}

// Data replication: local read model for users (source: Identity service via user.created events).
model ReplicatedUserModel {
  id                   String    @id
  email                String
  name                 String
  createdAt            DateTime  @map("created_at")
  lastEventAt          DateTime  @map("last_event_at")
  lastEventOccurredAt  DateTime? @map("last_event_occurred_at")

  @@map("replicated_users")
}

model ComplianceRetentionRunModel {
  id              String   @id @default(uuid())
  startedAt       DateTime @default(now()) @map("started_at")
  finishedAt      DateTime? @map("finished_at")
  status          String
  retentionDays   Int      @map("retention_days")
  cutoffAt        DateTime @map("cutoff_at")
  scannedCount    Int      @default(0) @map("scanned_count")
  eligibleCount   Int      @default(0) @map("eligible_count")
  monitorOnlyCount Int     @default(0) @map("monitor_only_count")
  errorMessage    String?  @map("error_message")

  @@map("compliance_retention_runs")
}
