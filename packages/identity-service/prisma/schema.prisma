generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma-client"
}

datasource db {
  provider = "postgresql"
  url      = env("IDENTITY_DATABASE_URL")
}

model UserModel {
  id                  String               @id @default(uuid())
  email               String               @unique
  name                String
  authorizationVersion Int                 @default(1) @map("authorization_version")
  isActive            Boolean              @default(true) @map("is_active")
  failedLoginAttempts Int                  @default(0) @map("failed_login_attempts")
  blockedUntil        DateTime?            @map("blocked_until")
  createdAt           DateTime             @default(now()) @map("created_at")
  authCredential      AuthCredentialModel?
  oauthAccounts       OAuthAccountModel[]
  userRoles           UserRoleModel[]

  @@map("users")
}

model RoleModel {
  id              String             @id @default(uuid())
  code            String             @unique
  name            String
  description     String?
  isSystem        Boolean            @default(true) @map("is_system")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  rolePermissions RolePermissionModel[]
  userRoles       UserRoleModel[]

  @@map("roles")
}

model PermissionModel {
  id              String                @id @default(uuid())
  code            String                @unique
  name            String
  description     String?
  module          String?
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")
  rolePermissions RolePermissionModel[]

  @@map("permissions")
}

model RolePermissionModel {
  roleId       String          @map("role_id")
  permissionId String          @map("permission_id")
  createdAt    DateTime        @default(now()) @map("created_at")
  role         RoleModel       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   PermissionModel @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRoleModel {
  userId     String    @id @map("user_id")
  roleId     String    @map("role_id")
  assignedBy String?   @map("assigned_by")
  assignedAt DateTime  @default(now()) @map("assigned_at")
  user       UserModel @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       RoleModel @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([roleId])
  @@map("user_roles")
}

model AuthCredentialModel {
  id           String   @id @default(uuid())
  userId       String   @unique @map("user_id")
  passwordHash String   @map("password_hash")
  user         UserModel @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_credentials")
}

model OAuthAccountModel {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  provider   String   // "google" | "github"
  providerId String   @map("provider_id")
  createdAt  DateTime @map("created_at")
  user       UserModel @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@map("oauth_accounts")
}

// Outbox table for reliable event publishing (Outbox Pattern). Rows are published by the outbox relay.
model OutboxModel {
  id         String   @id @default(uuid())
  eventName  String   @map("event_name")
  payload    Json     @db.JsonB
  createdAt  DateTime @map("created_at")
  publishedAt DateTime? @map("published_at")

  @@index([publishedAt])
  @@map("outbox")
}
