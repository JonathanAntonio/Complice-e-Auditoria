# PostgreSQL (Docker Compose + connection strings for services)
POSTGRES_USER=lframework
POSTGRES_PASSWORD=lframework
POSTGRES_DB=lframework
POSTGRES_PORT=5432

# Connection strings (use in services; separate DBs per service)
DATABASE_URL=postgresql://lframework:lframework@localhost:5432/lframework
IDENTITY_DATABASE_URL=postgresql://lframework:lframework@localhost:5432/lframework_identity
CATALOG_DATABASE_URL=postgresql://lframework:lframework@localhost:5432/lframework
INTEGRATION_DATABASE_URL=postgresql://lframework:lframework@localhost:5432/lframework_integration

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# RabbitMQ (Docker Compose)
RABBITMQ_USER=lframework
RABBITMQ_PASSWORD=lframework
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://lframework:lframework@localhost:5672

# Portas dos serviços
IDENTITY_SERVICE_PORT=3001
CATALOG_SERVICE_PORT=3002
INTEGRATION_SERVICE_PORT=3003
API_DOCS_PORT=3000

# Nginx no Docker: porta no host (container escuta 80). Sem Docker use 80 no host.
GATEWAY_PORT=8080

# Frontend (entrada pública única)
FRONTEND_PORT=5173
FRONTEND_BFF_URL=http://localhost:3004

# BFF (Backend For Frontend)
BFF_PORT=3004
BFF_GATEWAY_URL=http://localhost:8080
BFF_IAM_AUTH_BASE_PATH=/identity/api/auth
BFF_PUBLIC_BASE_URL=https://seu-dominio.ngrok-free.app
BFF_SESSION_COOKIE_NAME=complice_session
BFF_SESSION_MAX_AGE_SECONDS=604800

# Identity: auth
JWT_SECRET=change-me-in-production-use-a-long-random-secret
JWT_EXPIRES_IN_SECONDS=604800
# URL pública do identity via gateway (use domínio/ngrok em dev externo).
BASE_URL=https://seu-dominio.ngrok-free.app/identity
CORS_ORIGIN=

# OAuth (opcional; deixe em branco para desativar)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Integration service
INTEGRATION_API_KEY=change-me-with-at-least-16-chars
INTEGRATION_BASE_URL=http://localhost:3003

# Ngrok (opcional, para webhooks/demo)
NGROK_AUTHTOKEN=
