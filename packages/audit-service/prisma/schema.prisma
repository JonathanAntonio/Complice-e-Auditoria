generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("AUDIT_DATABASE_URL")
}

model AuditLogModel {
  id            String   @id @default(uuid())
  eventId       String   @unique @map("event_id")
  eventType     String   @map("event_type")
  occurredAtUTC DateTime @map("occurred_at_utc")
  recordedAtUTC DateTime @default(now()) @map("recorded_at_utc")
  actorId       String?  @map("actor_id")
  actorType     String?  @map("actor_type")
  sourceService String   @map("source_service")
  correlationId String   @map("correlation_id")
  severity      String
  payload       Json     @db.JsonB

  @@index([occurredAtUTC])
  @@index([eventType])
  @@index([actorId])
  @@index([severity])
  @@map("audit_logs")
}

model AuditRetentionRunModel {
  id               String   @id @default(uuid())
  startedAt        DateTime @default(now()) @map("started_at")
  finishedAt       DateTime? @map("finished_at")
  status           String
  retentionDays    Int      @map("retention_days")
  cutoffAt         DateTime @map("cutoff_at")
  scannedCount     Int      @default(0) @map("scanned_count")
  eligibleCount    Int      @default(0) @map("eligible_count")
  monitorOnlyCount Int      @default(0) @map("monitor_only_count")
  errorMessage     String?  @map("error_message")

  @@map("audit_retention_runs")
}
